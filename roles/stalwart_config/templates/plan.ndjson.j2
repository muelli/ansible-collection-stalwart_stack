{#- Builds the declarative plan. One JSON operation per line. -#}
{%- set ops = namespace(list=[]) -%}

{#- Stage 0: listeners -#}
{%- set listeners = {} -%}
{%- set all_listeners = stalwart_server_listeners + (stalwart_required_listeners | rejectattr('name', 'in', stalwart_server_listeners | map(attribute='name') | list) | list) -%}
{%- for l in all_listeners if l.state | default('present', true) == 'present' -%}
{%-   set binds = {} -%}
{%-   for b in l.bind -%}{%- set _ = binds.update({b: true}) -%}{%- endfor -%}
{#-   Stalwart models sets as {value: true}; accept plain lists for such options. -#}
{%-   set opts = {} -%}
{%-   for key, val in (l.options | default({})).items() -%}
{%-     if val is sequence and val is not string and val is not mapping -%}
{%-       set as_set = {} -%}
{%-       for e in val -%}{%- set _ = as_set.update({e: true}) -%}{%- endfor -%}
{%-       set _ = opts.update({key: as_set}) -%}
{%-     else -%}
{%-       set _ = opts.update({key: val}) -%}
{%-     endif -%}
{%-   endfor -%}
{%-   set _ = listeners.update({l.name: ({'name': l.name, 'protocol': l.protocol, 'bind': binds} | combine(opts))}) -%}
{%- endfor -%}
{%- for l in stalwart_server_listeners if l.state | default('present', true) == 'absent' -%}
{%-   set ops.list = ops.list + [{'@type': 'destroy', 'object': 'NetworkListener', 'value': {'name': l.name}}] -%}
{%- endfor -%}
{%- set ops.list = ops.list + [{'@type': 'upsert', 'object': 'NetworkListener', 'matchOn': ['name'], 'value': listeners}] -%}

{#- Stage 1: outbound relays (MtaRoute) -#}
{%- for route in stalwart_relay_hosts if route.state | default('present', true) == 'absent' -%}
{%-   set ops.list = ops.list + [{'@type': 'destroy', 'object': 'MtaRoute', 'value': {'name': route.name}}] -%}
{%- endfor -%}
{%- for route in stalwart_relay_hosts if route.state | default('present', true) == 'present' -%}
{%-   set fields = {
        '@type': 'Relay', 'name': route.name, 'host': route.address, 'port': route.port | default(25) | int,
        'protocol': route.protocol | default('smtp') | lower, 'implicitTls': route.implicit_tls | default(false) | bool,
        'allowInvalidCerts': route.allow_invalid_certs | default(false) | bool, 'description': route.description | default(none)
      } -%}
{%-   if route.auth_username is defined -%}{%- set _ = fields.update({'authUsername': route.auth_username}) -%}{%- endif -%}
{%-   if route.auth_secret is defined -%}{%- set _ = fields.update({'authSecret': {'@type': 'Value', 'secret': route.auth_secret}}) -%}{%- endif -%}
{%-   set ops.list = ops.list + [{'@type': 'upsert', 'object': 'MtaRoute', 'matchOn': ['name'], 'value': {'route-' ~ route.name: fields}}] -%}
{%- endfor -%}

{#- Stage 1b: web applications served by Stalwart (zip bundles under URL prefixes) -#}
{#- Applications marked absent are deleted by id in tasks/main.yml: Stalwart cannot filter them. -#}
{%- for app in stalwart_applications if app.state | default('present', true) == 'present' -%}
{%-   set prefixes = {} -%}
{%-   for p in app.url_prefix -%}{%- set _ = prefixes.update({p: true}) -%}{%- endfor -%}
{%-   set fields = {
        'description': app.description, 'urlPrefix': prefixes, 'resourceUrl': app.resource_url,
        'enable': app.enable | default(true) | bool
      } -%}
{%-   if app.auto_update_interval is defined -%}{%- set _ = fields.update({'autoUpdateInterval': app.auto_update_interval | int}) -%}{%- endif -%}
{%-   if app.oauth_client_id is defined -%}{%- set _ = fields.update({'oauthClientId': app.oauth_client_id}) -%}{%- endif -%}
{%-   set ops.list = ops.list + [{'@type': 'upsert', 'object': 'Application', 'matchOn': ['description'], 'value': {'app-' ~ app.description: fields}}] -%}
{%- endfor -%}

{#- Stage 2: DNS providers, one per distinct provider in use -#}
{%- for dns in stalwart_absent_dns_providers -%}
{%-   set ops.list = ops.list + [{'@type': 'destroy', 'object': 'DnsServer', 'value': {'description': dns | capitalize}}] -%}
{%- endfor -%}
{%- set used = stalwart_domains | selectattr('state', 'equalto', 'present') | selectattr('dns', 'defined') | map(attribute='dns') | map('lower') | unique | list -%}
{%- for dns in used -%}
{%-   set provider = stalwart_dns_provider_map[dns] | default('') -%}
{%-   set creds = dns_key_map[dns] | default({}) -%}
{%-   if provider and creds | length > 0 -%}
{%-     set fields = {'@type': provider, 'description': dns | capitalize, 'timeout': 30000} -%}
{%-     for key, val in creds.items() -%}
{%-       set rule = (stalwart_dns_field_meta[dns] | default({}))[key] | default({}) -%}
{%-       if rule.type | default('String') == 'SecretKey' -%}
{%-         set _ = fields.update({rule.name | default(key): {'@type': 'Value', 'secret': val}}) -%}
{%-       else -%}
{%-         set _ = fields.update({rule.name | default(key): val}) -%}
{%-       endif -%}
{%-     endfor -%}
{%-     set ops.list = ops.list + [{'@type': 'upsert', 'object': 'DnsServer', 'matchOn': ['description'], 'value': {'dns-' ~ dns: fields}}] -%}
{%-   endif -%}
{%- endfor -%}

{#- Stage 3a: ACME accounts, for the domains with `certificate: acme` (Stalwart orders those itself). -#}
{%- set acme_challenge = {'dns01': 'Dns01', 'http01': 'Http01', 'tls-alpn01': 'TlsAlpn01', 'dns-persist01': 'DnsPersist01'} -%}
{%- set acme_renew = {'1/2': 'R12', '2/3': 'R23', '3/4': 'R34', '4/5': 'R45'} -%}
{%- for prov in stalwart_acme_providers | default([]) -%}
{%-   set fields = {
        'description': prov.name,
        'directory': prov.directory,
        'challengeType': acme_challenge[prov.challenge | default('dns01')],
        'contact': {prov.contact: true},
        'renewBefore': acme_renew[prov.renew_before | default('2/3')],
        'reuseKey': prov.reuse_key | default(false) | bool} -%}
{%-   if prov.eab_key_id is defined -%}{%- set _ = fields.update({'eabKeyId': prov.eab_key_id, 'eabHmacKey': {'@type': 'Value', 'secret': prov.eab_hmac_key}}) -%}{%- endif -%}
{%-   set ops.list = ops.list + [{'@type': 'upsert', 'object': 'AcmeProvider', 'matchOn': ['description'], 'value': {'acme-' ~ prov.name: fields}}] -%}
{%- endfor -%}

{#- Stage 3: certificates synced from Caddy (not for the domains Stalwart orders itself) -#}
{%- for domain in stalwart_domains if domain.state == 'present' and domain.certificate | default('caddy') != 'acme' -%}
{%-   set slug = 'certificate-' ~ (domain.name | replace('.', '-')) -%}
{%-   set ops.list = ops.list + [{
        '@type': 'upsert', 'object': 'Certificate', 'matchOn': ['subjectAlternativeNames'],
        'value': {slug: {
          'certificate': {'@type': 'File', 'filePath': stalwart_certs_dir ~ '/' ~ domain.name ~ '.crt'},
          'privateKey': {'@type': 'File', 'filePath': stalwart_certs_dir ~ '/' ~ domain.name ~ '.key'},
          'subjectAlternativeNames': {domain.name: true}}}}] -%}
{%- endfor -%}

{#- The host name of the server is not a mail domain but needs a certificate for the mail ports. -#}
{%- set domain_names = stalwart_domains | selectattr('state', 'equalto', 'present') | map(attribute='name') | list -%}
{%- if stalwart_hostname is defined and stalwart_hostname | length > 0 and stalwart_hostname not in domain_names and not (stalwart_acme_hostname_covered | default(false) | bool) -%}
{%-   set ops.list = ops.list + [{
        '@type': 'upsert', 'object': 'Certificate', 'matchOn': ['subjectAlternativeNames'],
        'value': {('certificate-' ~ (stalwart_hostname | replace('.', '-'))): {
          'certificate': {'@type': 'File', 'filePath': stalwart_certs_dir ~ '/' ~ stalwart_hostname ~ '.crt'},
          'privateKey': {'@type': 'File', 'filePath': stalwart_certs_dir ~ '/' ~ stalwart_hostname ~ '.key'},
          'subjectAlternativeNames': {stalwart_hostname: true}}}}] -%}
{%- endif -%}

{#- Stage 4: domains -#}
{%- for domain in stalwart_domains if domain.state == 'absent' -%}
{%-   set ops.list = ops.list + [{'@type': 'destroy', 'object': 'Domain', 'value': {'name': domain.name}}] -%}
{%- endfor -%}
{#- A Domain refers to its certificate, so the certificate goes after the Domain. -#}
{%- for domain in stalwart_domains if domain.state == 'absent' -%}
{%-   set ops.list = ops.list + [{'@type': 'destroy', 'object': 'Certificate', 'value': {'subjectAlternativeNames': domain.name}}] -%}
{%- endfor -%}
{%- for domain in stalwart_domains if domain.state == 'present' -%}
{%-   set slug = 'certificate-' ~ (domain.name | replace('.', '-')) -%}
{%-   set dns_mgmt = {'@type': 'Automatic', 'dnsServerId': '#dns-' ~ (domain.dns | lower)} if domain.dns is defined else {'@type': 'Manual'} -%}
{%-   if domain.dns is defined and domain.zone_origin is defined -%}{%- set _ = dns_mgmt.update({'origin': domain.zone_origin}) -%}{%- endif -%}
{%-   if domain.certificate | default('caddy') == 'acme' -%}
{%-     set san = {} -%}
{%-     for n in domain.acme_names | default([]) -%}{%- set _ = san.update({n: true}) -%}{%- endfor -%}
{%-     set cert_mgmt = {'@type': 'Automatic', 'acmeProviderId': '#acme-' ~ (domain.acme_provider | default(stalwart_acme_default_provider)), 'subjectAlternativeNames': san} -%}
{%-   else -%}
{%-     set cert_mgmt = {'@type': 'Manual', 'certificateId': '#' ~ slug} -%}
{%-   endif -%}
{%-   set fields = {
          'name': domain.name,
          'certificateManagement': cert_mgmt,
          'dnsManagement': dns_mgmt} -%}
{#- Without catch_all the server's value is left alone; null or "" clears it. -#}
{%-   if domain.catch_all is defined -%}{%- set _ = fields.update({'catchAllAddress': (domain.catch_all or none)}) -%}{%- endif -%}
{%-   set ops.list = ops.list + [{
        '@type': 'upsert', 'object': 'Domain', 'matchOn': ['name'],
        'value': {'domain-' ~ (domain.name | replace('.', '-')): fields}}] -%}
{%- endfor -%}

{#- Stage 4b: accounts and mailing lists. Their domains are the ones upserted above, referenced by label;
    a domain outside stalwart_domains makes the apply fail and the failure names it. Entries marked
    absent are removed by tasks/absent_addresses.yml before the plan runs. No credentials are written:
    an update leaves the password of an existing account alone. -#}
{#- Groups come first, so that accounts can reference them (`groups:`, Account.memberGroupIds). -#}
{%- for grp in stalwart_groups if grp.state | default('present', true) == 'present' -%}
{%-   set fields = {'@type': 'Group', 'name': grp.name, 'domainId': '#domain-' ~ (grp.domain | replace('.', '-'))} -%}
{%-   if grp.description is defined -%}{%- set _ = fields.update({'description': grp.description}) -%}{%- endif -%}
{%-   if grp.aliases is defined -%}
{%-     set al = {} -%}
{%-     for addr in grp.aliases -%}
{#-       An alias is an address, or {address: ..., enabled: false} to keep it but make it refuse mail. -#}
{%-       set _addr = addr if addr is string else addr.address -%}
{%-       set _on = true if addr is string else (addr.enabled | default(true) | bool) -%}
{%-       set _ = al.update({loop.index0 | string: {'name': _addr.split('@')[0], 'domainId': '#domain-' ~ (_addr.split('@')[1] | replace('.', '-')), 'enable': _on}}) -%}
{%-     endfor -%}
{%-     set _ = fields.update({'aliases': al}) -%}
{%-   endif -%}
{%-   set ops.list = ops.list + [{
        '@type': 'upsert', 'object': 'Account', 'matchOn': ['name', 'domainId'],
        'value': {'group-' ~ (grp.name ~ '-' ~ grp.domain | replace('.', '-')): fields}}] -%}
{%- endfor -%}
{%- for acc in stalwart_accounts if acc.state | default('present', true) == 'present' -%}
{%-   set fields = {'@type': 'User', 'name': acc.name, 'domainId': '#domain-' ~ (acc.domain | replace('.', '-'))} -%}
{%-   if acc.description is defined -%}{%- set _ = fields.update({'description': acc.description}) -%}{%- endif -%}
{#-   Without `groups` the memberships are left alone; [] removes them all. -#}
{%-   if acc.groups is defined -%}
{%-     set mg = {} -%}
{%-     for g in acc.groups -%}{%- set _ = mg.update({'#group-' ~ (g.split('@')[0] ~ '-' ~ g.split('@')[1] | replace('.', '-')): true}) -%}{%- endfor -%}
{%-     set _ = fields.update({'memberGroupIds': mg}) -%}
{%-   endif -%}
{#-   Without `aliases` the account's aliases are left alone; [] removes them all. -#}
{%-   if acc.aliases is defined -%}
{%-     set al = {} -%}
{%-     for addr in acc.aliases -%}
{#-       An alias is an address, or {address: ..., enabled: false} to keep it but make it refuse mail. -#}
{%-       set _addr = addr if addr is string else addr.address -%}
{%-       set _on = true if addr is string else (addr.enabled | default(true) | bool) -%}
{%-       set _ = al.update({loop.index0 | string: {'name': _addr.split('@')[0], 'domainId': '#domain-' ~ (_addr.split('@')[1] | replace('.', '-')), 'enable': _on}}) -%}
{%-     endfor -%}
{%-     set _ = fields.update({'aliases': al}) -%}
{%-   endif -%}
{%-   set ops.list = ops.list + [{
        '@type': 'upsert', 'object': 'Account', 'matchOn': ['name', 'domainId'],
        'value': {'account-' ~ (acc.name ~ '-' ~ acc.domain | replace('.', '-')): fields}}] -%}
{%- endfor -%}
{%- for lst in stalwart_lists if lst.state | default('present', true) == 'present' -%}
{%-   set rcpt = {} -%}
{%-   for addr in lst.recipients | default([]) -%}{%- set _ = rcpt.update({addr: true}) -%}{%- endfor -%}
{%-   set fields = {'name': lst.name, 'domainId': '#domain-' ~ (lst.domain | replace('.', '-')), 'recipients': rcpt} -%}
{%-   if lst.description is defined -%}{%- set _ = fields.update({'description': lst.description}) -%}{%- endif -%}
{%-   if lst.aliases is defined -%}
{%-     set al = {} -%}
{%-     for addr in lst.aliases -%}
{#-       An alias is an address, or {address: ..., enabled: false} to keep it but make it refuse mail. -#}
{%-       set _addr = addr if addr is string else addr.address -%}
{%-       set _on = true if addr is string else (addr.enabled | default(true) | bool) -%}
{%-       set _ = al.update({loop.index0 | string: {'name': _addr.split('@')[0], 'domainId': '#domain-' ~ (_addr.split('@')[1] | replace('.', '-')), 'enable': _on}}) -%}
{%-     endfor -%}
{%-     set _ = fields.update({'aliases': al}) -%}
{%-   endif -%}
{%-   set ops.list = ops.list + [{
        '@type': 'upsert', 'object': 'MailingList', 'matchOn': ['name', 'domainId'],
        'value': {'list-' ~ (lst.name ~ '-' ~ lst.domain | replace('.', '-')): fields}}] -%}
{%- endfor -%}

{#- Stage 4c: what to do with mail to certain recipient addresses (stalwart_recipient_policies).
    One key-value entry per address maps it to a spam tag, one `Email` spam rule looks every address of
    a message up and returns that tag, and the three tags decide the outcome: spam (score, so the message
    goes to Junk), discard (accepted and dropped) or reject (refused after DATA). Entries marked absent
    are deleted by id in tasks/policies.yml, because a lookup entry can only be filtered by namespace.
    The rule is named in capitals because that is how Stalwart stores rule names. -#}
{%- set pol_present = stalwart_recipient_policies | selectattr('state', 'undefined') | list
                      + stalwart_recipient_policies | selectattr('state', 'defined') | selectattr('state', 'equalto', 'present') | list -%}
{%- set pol_tags = {'spam': 'RCPT_SPAM', 'discard': 'RCPT_DISCARD', 'reject': 'RCPT_REJECT'} -%}
{#- The rule and tags are written whenever the variable is used at all, and the rule is switched off
    once no present entry is left, so removing the last policy leaves nothing active behind. -#}
{%- if stalwart_recipient_policies | length > 0 -%}
{%-   for p in pol_present -%}
{%-     set _ = ops.list.append({
          '@type': 'upsert', 'object': 'MemoryLookupKeyValue', 'matchOn': ['namespace', 'key'],
          'value': {'policy-' ~ loop.index0: {
            'namespace': stalwart_recipient_policy_namespace, 'key': p.address | lower,
            'value': pol_tags[p.action], 'isGlobPattern': ('*' in p.address or '?' in p.address)}}}) -%}
{%-   endfor -%}
{%-   set _ = ops.list.append({'@type': 'upsert', 'object': 'SpamTag', 'matchOn': ['tag'],
          'value': {'policy-tag-spam': {'@type': 'Score', 'tag': 'RCPT_SPAM', 'score': stalwart_recipient_policy_spam_score}}}) -%}
{%-   set _ = ops.list.append({'@type': 'upsert', 'object': 'SpamTag', 'matchOn': ['tag'],
          'value': {'policy-tag-discard': {'@type': 'Discard', 'tag': 'RCPT_DISCARD'}}}) -%}
{%-   set _ = ops.list.append({'@type': 'upsert', 'object': 'SpamTag', 'matchOn': ['tag'],
          'value': {'policy-tag-reject': {'@type': 'Reject', 'tag': 'RCPT_REJECT'}}}) -%}
{%-   set _ = ops.list.append({'@type': 'upsert', 'object': 'SpamRule', 'matchOn': ['name'],
          'value': {'policy-rule': {'@type': 'Email', 'name': 'RCPT-POLICY', 'enable': (pol_present | length > 0), 'priority': 100,
            'condition': {'else': "key_get('" ~ stalwart_recipient_policy_namespace ~ "', email)"}}}}) -%}
{%- endif -%}

{#- Stage 4d: the From header of mail submitted by users (stalwart_enforce_from_header). Stalwart only
    forces the envelope sender to be the user's own address; this DATA-stage Sieve script makes the
    visible From address the same one. null leaves the server alone, false removes the hook. -#}
{%- if stalwart_enforce_from_header is not none -%}
{#-   An update merges objects, so the old rules have to be emptied explicitly. -#}
{%-   set from_hook = {'match': {}, 'else': 'false'} -%}
{%-   if stalwart_enforce_from_header | bool -%}
{%-     set cond = namespace(text='!is_empty(authenticated_as)') -%}
{%-     for who in stalwart_enforce_from_header_except -%}{%- set cond.text = cond.text ~ " && authenticated_as != '" ~ who ~ "'" -%}{%- endfor -%}
{%-     set from_script -%}
{% raw %}require ["variables", "reject", "envelope"];
# Several mailboxes in one From header: refuse, only one can be checked against the envelope.
if header :matches "from" "*,*" {
  reject "550 5.7.1 Exactly one From address is allowed.";
  stop;
}
if not address :all :is "from" "${envelope.from}" {
  reject "550 5.7.1 The From address must be the address you send from.";
}
{% endraw %}{%-     endset -%}
{%-     set ops.list = ops.list + [{'@type': 'upsert', 'object': 'SieveSystemScript', 'matchOn': ['name'],
          'value': {'from-check': {'name': 'from-check', 'isActive': true, 'description': 'Managed by Ansible: From must equal the envelope sender', 'contents': from_script}}}] -%}
{%-     set from_hook = {'match': {'0': {'if': cond.text, 'then': "'from-check'"}}, 'else': 'false'} -%}
{%-   endif -%}
{%-   set ops.list = ops.list + [{'@type': 'update', 'object': 'MtaStageData', 'id': 'singleton', 'value': {'script': from_hook}}] -%}
{%- endif -%}

{#- Stage 4e: webhooks (stalwart_webhooks), matched by URL. Events are listed by name: the set does not
    accept wildcards. -#}
{%- for hook in stalwart_webhooks -%}
{#-   Absent webhooks are deleted by id in tasks/webhooks.yml: a WebHook cannot be filtered by URL. -#}
{%-   if hook.state | default('present') != 'absent' -%}
{%-     set evs = {} -%}
{%-     for e in hook.events | default(stalwart_webhook_default_events) -%}{%- set _ = evs.update({e: true}) -%}{%- endfor -%}
{%-     set fields = {'url': hook.url, 'enable': hook.enable | default(true) | bool, 'events': evs,
          'eventsPolicy': hook.events_policy | default('include'), 'level': hook.level | default('warn')} -%}
{%-     if hook.bearer_token is defined -%}
{%-       set _ = fields.update({'httpAuth': {'@type': 'Bearer', 'bearerToken': {'@type': 'Value', 'secret': hook.bearer_token}}}) -%}
{%-     elif hook.basic_user is defined -%}
{%-       set _ = fields.update({'httpAuth': {'@type': 'Basic', 'username': hook.basic_user, 'secret': {'@type': 'Value', 'secret': hook.basic_password}}}) -%}
{%-     endif -%}
{%-     if hook.signature_key is defined -%}{%- set _ = fields.update({'signatureKey': {'@type': 'Value', 'secret': hook.signature_key}}) -%}{%- endif -%}
{%-     if hook.headers is defined -%}{%- set _ = fields.update({'httpHeaders': hook.headers}) -%}{%- endif -%}
{%-     for key, field in {'timeout': 'timeout', 'throttle': 'throttle', 'discard_after': 'discardAfter'}.items() if hook[key] is defined -%}
{%-       set _ = fields.update({field: hook[key] | int}) -%}
{%-     endfor -%}
{%-     for key, field in {'lossy': 'lossy', 'allow_invalid_certs': 'allowInvalidCerts'}.items() if hook[key] is defined -%}
{%-       set _ = fields.update({field: hook[key] | bool}) -%}
{%-     endfor -%}
{%-     set ops.list = ops.list + [{'@type': 'upsert', 'object': 'WebHook', 'matchOn': ['url'], 'value': {'webhook-' ~ loop.index: fields}}] -%}
{%-   endif -%}
{%- endfor -%}

{#- Stage 5: system settings -#}
{%- set trusted = {} -%}
{%- for net in stalwart_global_proxy_trusted_networks -%}{%- set _ = trusted.update({net: true}) -%}{%- endfor -%}
{%- set settings = {'proxyTrustedNetworks': trusted} -%}
{%- if stalwart_hostname is defined -%}{%- set _ = settings.update({'defaultHostname': stalwart_hostname}) -%}{%- endif -%}
{%- if stalwart_default_domain | length > 0 -%}{%- set _ = settings.update({'defaultDomainId': '#domain-' ~ (stalwart_default_domain | replace('.', '-'))}) -%}{%- endif -%}
{%- set ops.list = ops.list + [{'@type': 'update', 'object': 'SystemSettings', 'value': settings}] -%}

{%- set ops.list = ops.list + [{'@type': 'update', 'object': 'Http', 'id': 'singleton', 'value': {'usePermissiveCors': stalwart_permissive_cors | bool}}] -%}
{%- if stalwart_redirect_root | length > 0 -%}
{%-   set ops.list = ops.list + [{'@type': 'update', 'object': 'Http', 'id': 'singleton', 'value': {'redirectRoot': stalwart_redirect_root}}] -%}
{%- endif -%}

{#- Stage 6: sender-domain based outbound routing -#}
{%- set match = {'0': {'if': 'is_local_domain(rcpt_domain)', 'then': "'local'"}} -%}
{%- set idx = namespace(n=1) -%}
{#- `user@host` compares the whole sender, `@host` its domain; addresses go first. -#}
{%- set active_rules = sender_domain_routing | selectattr('state', 'undefined') | list + sender_domain_routing | selectattr('state', 'defined') | selectattr('state', 'equalto', 'present') | list -%}
{%- for want_domain in [false, true] -%}
{%-   for rule in active_rules if rule.sender.startswith('@') == want_domain -%}
{%-     set cond = ("sender_domain == '" ~ rule.sender[1:] ~ "'") if want_domain else ("sender == '" ~ rule.sender ~ "'") -%}
{%-     set _ = match.update({idx.n | string: {'if': cond, 'then': "'" ~ rule.route ~ "'"}}) -%}
{%-     set idx.n = idx.n + 1 -%}
{%-   endfor -%}
{%- endfor -%}
