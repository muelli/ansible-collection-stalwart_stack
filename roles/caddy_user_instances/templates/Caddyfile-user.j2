# Managed by Ansible (caddy_user_instances). Bare minimum: everything else
# lives in conf.d/*.conf. The files of the sites in caddy_user_instances are
# written there; add your own next to them, they are left alone.
{
    # Admin API on a UNIX socket in the user's runtime directory.
    admin "unix//{$XDG_RUNTIME_DIR}/caddy-admin.sock"
    auto_https off
    # The fronting Caddy reaches every site through this socket.
    default_bind unix//{$XDG_RUNTIME_DIR}/caddy-internal.sock
}

import {{ _caddy_conf_dir }}/*.conf
{% if caddy_user_item.fallback | default('') | length > 0 %}

# Catch-all: every request on a host no other site block names.
http:// {
{{ caddy_user_item.fallback | indent(4, true) }}
}
{% endif %}
