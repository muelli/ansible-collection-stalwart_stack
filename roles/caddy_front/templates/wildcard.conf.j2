{% import 'macros.j2' as macros with context %}
# Managed by Ansible (caddy_front). Holds the one certificate for the names
# below {{ item }}; the names the roles serve have their own site files and
# use it (Caddy 2.10+ prefers a wildcard certificate over per-name ones).
*.{{ item }} {
    respond "Not found" 404
{% set dns = (stalwart_domains | selectattr('name', 'equalto', item) | first).dns | default(none) %}
{% if caddy_tls_mode == 'internal' %}

    tls internal
{% elif dns %}

    tls {
{{ macros.render_caddy_dns(dns, dns_key_map, caddy_dns_field_map) | indent(8, true) }}
        propagation_delay 30s
    }
{% endif %}
}
