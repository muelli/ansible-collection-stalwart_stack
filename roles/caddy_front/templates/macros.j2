{% macro render_caddy_dns(dns_provider, dns_key_map, caddy_dns_field_map) %}
{% set creds = dns_key_map[dns_provider] | default({}) %}
{% set meta = caddy_dns_field_map[dns_provider] | default({}) %}
{% if meta.layout | default('block') == 'anonymous' %}
dns {{ dns_provider }} "{env.{{ dns_provider | upper }}_{{ (creds.keys() | list | first) | upper }}}"
{% else %}
dns {{ dns_provider }} {
{%   for key in creds %}
    {{ (meta.fields | default({}))[key] | default(key) }} "{env.{{ dns_provider | upper }}_{{ key | upper }}}"
{%   endfor %}
}
{% endif %}
{% endmacro %}

{% macro site_body(item) %}
{% if item.kind == 'stalwart' %}
    handle {
        reverse_proxy {{ stalwart_http_proxyv2_listener }} {
            transport http {
                proxy_protocol v2
            }
        }
    }
{% else %}
{% if item.caddy_directive is defined and item.caddy_directive | length > 0 %}
{{ item.caddy_directive | indent(4, true) }}

{% endif %}
{% if item.user is defined %}
    handle {
        reverse_proxy unix/{{ caddy_user_socket_dir }}/{{ item.user }}.sock
    }
{% endif %}
{% endif %}
{% endmacro %}
