# Managed by Ansible (caddy_front). DNS API credentials for the Caddy plugins.
{% set seen = [] %}
{% for d in (stalwart_domains + caddy_domains) if d.state | default('present', true) == 'present' and d.dns is defined %}
{%   if d.dns not in seen %}
{%     set _ = seen.append(d.dns) %}
{%     for key, value in (dns_key_map[d.dns] | default({})).items() %}
{{ d.dns | upper }}_{{ key | upper }}={{ value }}
{%     endfor %}
{%   endif %}
{% endfor %}
