# Managed by Ansible (stalwart_install).
[Unit]
Description=Stalwart
Conflicts=postfix.service sendmail.service exim4.service
ConditionPathExists={{ stalwart_config_dir }}/config.json
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
LimitNOFILE=65536
KillMode=process
KillSignal=SIGINT
Restart=on-failure
RestartSec=5
EnvironmentFile=-{{ stalwart_config_dir }}/stalwart.env
ExecStart={{ stalwart_bin_dir }}/stalwart --config={{ stalwart_config_dir }}/config.json
SyslogIdentifier=stalwart
User={{ stalwart_system_user }}
Group={{ stalwart_system_group }}
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
